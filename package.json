{
	"name": "@nutrifriz/api",
	"version": "1.0.0",
	"private": true,
	"description": "Nutrifriz backend API — Node, Express, MongoDB, TypeScript, Paystack",
	"main": "dist/server.js",
	"scripts": {
		"dev": "nodemon",
		"build": "tsc -p tsconfig.json",
